# ==============================================================================
# CHARWATCH — VERCEL DEPLOYMENT ENVIRONMENT VARIABLES
# ==============================================================================
# Add these keys in your Vercel Project Settings:
# Settings > Environment Variables > Add New Variable
# ==============================================================================

# 1. Google Gemini AI API Key (REQUIRED for Live AI River Analyst Drawer)
# Get a free key at: https://aistudio.google.com/
# Key Name: GEMINI_API_KEY
# Environments: Production, Preview, Development
GEMINI_API_KEY=""

# 2. Google Maps Platform API Key (OPTIONAL — built-in fallback is included)
# Key Name: VITE_GOOGLE_MAPS_API_KEY
# If left blank, the app uses its verified embedded demo key automatically.
VITE_GOOGLE_MAPS_API_KEY=""

# 3. Node Environment (Handled automatically by Vercel)
NODE_ENV="production"
